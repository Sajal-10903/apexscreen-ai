# ===========================================
# AI Interview System - Environment Variables
# ===========================================
# Copy this file to .env and fill in values:
#   cp .env.example .env

# --- Gemini LLM Provider (Primary) ---
# Leave GEMINI_API_KEY empty to use deterministic mock/demo mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- OpenAI LLM Provider (Secondary/Alternative) ---
# Leave OPENAI_API_KEY empty to use Gemini or mock/demo mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Database ---
DATABASE_URL=sqlite:///./data/interview.db

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector Database ---
CHROMA_PERSIST_DIRECTORY=./chroma_db

# --- RAG ---
TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Interview ---
INTERVIEW_QUESTION_COUNT=8
MAX_RESUME_SIZE_MB=5

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# --- Logging ---
LOG_LEVEL=INFO
